{
  "name": "Eaglercraft 1.12.2 Server Node",
  "image": "://microsoft.com",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java"
      ]
    }
  },
  "forwardPorts": [ 8081 ],
  "portsAttributes": {
    "8081": {
      "label": "Eaglercraft WebSocket Proxy",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh"
}
